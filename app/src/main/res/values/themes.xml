<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Frosty" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night_indigo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorAccent">@color/berry_pink</item>
    </style>

    <!-- System splash (Android 12+ API, backported by core-splashscreen) -->
    <style name="Theme.Frosty.Starting" parent="Theme.SplashScreen">
        <!-- Plain white launch window that flows straight into the NG Studio ident. -->
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Frosty</item>
    </style>
</resources>
